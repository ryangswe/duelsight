{
  "name": "duelsight",
  "version": "0.8.1",
  "description": "Hover a Yu-Gi-Oh! card in a YouTube or Twitch video to see which card it is. Unofficial fan project, not affiliated with or endorsed by Konami.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "test": "tsc --noEmit && vitest run",
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "store:build": "node scripts/store-build.mjs",
    "vendor-check": "node vendor/cardvision-browser/cardvision-vendor-check.mjs vendor/cardvision-browser",
    "manual": "node test/manual/serve.mjs"
  },
  "dependencies": {
    "onnxruntime-web": "1.29.0"
  },
  "devDependencies": {
    "@types/chrome": "0.3.7",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.4",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
